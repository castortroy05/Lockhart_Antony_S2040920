<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".RoadSignActivity">

    <!-- Road Sign Frame -->
    <androidx.cardview.widget.CardView
        android:id="@+id/signFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="8dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/controlsLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <!-- Location/Reference Display -->
            <TextView
                android:id="@+id/locationDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="VMS LOCATION"
                android:textColor="#FF6600"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingBottom="8dp"
                android:shadowColor="#FF6600"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="4" />

            <!-- Separator Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#333333"
                android:layout_marginBottom="16dp" />

            <!-- Main Message Display -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/messageDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="LOADING MESSAGES..."
                    android:textAllCaps="true"
                    android:textColor="#FFB000"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.3"
                    android:padding="24dp"
                    android:shadowColor="#FFB000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="8"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />
            </ScrollView>

            <!-- Separator Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#333333"
                android:layout_marginTop="16dp" />

            <!-- LED Indicator Dots -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="12dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="#FFB000"
                    android:layout_margin="4dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="#FFB000"
                    android:layout_margin="4dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="#FFB000"
                    android:layout_margin="4dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Control Buttons Layout -->
    <LinearLayout
        android:id="@+id/controlsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Play/Pause Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/playPauseButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="⏸ PAUSE"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:icon="@android:drawable/ic_media_pause"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_marginBottom="8dp" />

        <!-- Navigation Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/prevButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="⏮ PREVIOUS"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:icon="@android:drawable/ic_media_previous"
                app:iconGravity="textStart"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="NEXT ⏭"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:icon="@android:drawable/ic_media_next"
                app:iconGravity="end"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
